{
  "mcpServers": {
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {}
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://seu_usuario:sua_senha@localhost:5432/habitos_db"
      ],
      "env": {}
    },
    "mongodb": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-mongodb",
        "mongodb://root:@devPass26@localhost:27017/habitos_db?authSource=admin"
      ],
      "env": {}
    },
    "redis": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-server-redis",
        "redis://localhost:6379"
      ],
      "env": {}
    },
    "docker": {
      "command": "npx",
      "args": [
        "-y",
        "@smithery/cli@latest",
        "run",
        "@docker/mcp-server-docker"
      ],
      "env": {}
    },
    "typescript-node": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-typescript",
        "--workspace",
        "./api"
      ],
      "env": {}
    },
    "eslint-analyzer": {
      "command": "npx",
      "args": [
        "-y",
        "@smithery/cli@latest",
        "run",
        "eslint-mcp-server"
      ],
      "env": {}
    }
  }
}
