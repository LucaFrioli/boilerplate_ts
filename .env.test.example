# =============================================================================
# .env.test.example — Template do Ambiente de Testes Automatizados
# =============================================================================
#
# PROPÓSITO DESTE ARQUIVO
# -----------------------
# Este arquivo é o TEMPLATE PÚBLICO do ambiente de testes.
# Ele documenta QUAIS variáveis existem e POR QUÊ cada uma tem um valor
# diferente do ambiente de desenvolvimento (.env).
#
# COMO USAR
# ---------
# 1. Copie este arquivo: `cp .env.test.example .env.test`
# 2. Ajuste os valores conforme sua máquina/ambiente de CI
# 3. O .env.test é carregado automaticamente pelo Vitest via setupFiles
#    (veja tests/helpers/env/loadTestEnv.ts)
#
# REGRAS DE SEGURANÇA
# -------------------
# ✅ .env.test.example → PODE ser commitado (não tem segredos reais)
# ❌ .env.test          → NUNCA commitar (está no .gitignore via .env.*)
# ❌ Nunca use valores do .env.test em produção ou desenvolvimento real
#
# FILOSOFIA DOS VALORES DE TESTE
# --------------------------------
# Os valores aqui são propositalmente diferentes da produção:
# - Hashers mais rápidos (menos custo de CPU) → testes mais ágeis
# - Banco de dados isolado → testes não poluem dados de dev
# - Pepper e segredos fictícios → segredos reais nunca chegam nos testes
# =============================================================================


# -----------------------------------------------------------------------------
# AMBIENTE — sempre "test" nos testes
# Garante que guards como `if (isProd)` no hasherEnv.schema.ts não disparem,
# e que o logger use nível 'debug' sem pino-pretty em modo test.
# -----------------------------------------------------------------------------
NODE_ENV=test

# -----------------------------------------------------------------------------
# SERVIDOR
# Em testes, o servidor não sobe (o Vitest não faz app.listen).
# Mas o env.ts valida a PORT mesmo assim — deixamos o valor padrão.
# -----------------------------------------------------------------------------
PORT=3000

# -----------------------------------------------------------------------------
# IDENTIFICAÇÃO DA APLICAÇÃO
# APP_NAME é validado com min(3)/max(50). Use um nome claro para distinguir
# logs de teste dos logs de desenvolvimento no mesmo agregador.
# -----------------------------------------------------------------------------
APP_NAME=Boilerplate_Test
APP_TIMEZONE=UTC
APP_LOCALE=pt-BR

# -----------------------------------------------------------------------------
# CONTATO DO ADMINISTRADOR
# Usado nas mensagens de erro crítico (BaseEntity.handlingError, BaseHasher.handleFatalErrors).
# Em testes, pode ser um email fictício — nunca será enviado.
# -----------------------------------------------------------------------------
EMAIL_TO_CONTACT=test-admin@boilerplate-test.local

# -----------------------------------------------------------------------------
# BANCO DE DADOS — Instância isolada de teste
#
# ⚠️ IMPORTANTE: Deve apontar para um banco DIFERENTE do desenvolvimento.
#    Testes de integração podem fazer DROP/TRUNCATE sem avisar.
#    Em CI/CD, suba uma instância via Docker antes de rodar os testes.
#
# DATABASE_NAME diferente garante que `mongodb://localhost:27017/test_db`
# nunca interfira no banco `boilerplate` do desenvolvimento.
# -----------------------------------------------------------------------------
DATABASE_TYPE=mongodb
DATABASE_HOST=localhost
DATABASE_PORT=27017
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_NAME=boilerplate_test
DATABASE_URI=

# Tipo de ID usado internamente pelo banco. Manter igual ao de produção
# para garantir que os testes reflitam o comportamento real.
DATABASE_ID_DEFAULT=uuidv7

# -----------------------------------------------------------------------------
# HASHER — Configuração DELIBERADAMENTE mais leve para testes
#
# CONTEXTO: O Argon2id em configuração de produção (timeCost=3, memory=65536)
# leva ~200-400ms por hash. Em um teste suite com 50 criações de usuário,
# isso seria 10-20 segundos APENAS em hashing.
#
# SOLUÇÃO: Em testes, usamos custo mínimo para que o hash seja funcional
# (ainda passa nas validações de formato) mas não consume CPU desnecessariamente.
#
# timeCost=1    → mínimo permitido pela spec do Argon2 (prod usa 3)
# memory=4096   → 4MB (prod usa 65536 = 64MB)
# parallelism=1 → 1 thread (prod usa 4+)
#
# ❌ NUNCA use estes valores em produção — violam RFC 9106 e OWASP.
# ✅ São seguros para testes porque o banco de dados de teste é descartável.
# -----------------------------------------------------------------------------
HASHER_PROVIDER=argon2
HASHER_SECURITY_PEPPER=Test@Pepper#Ficticio!Never4Prod
HASHER_LENGTH=32
HASHER_SALT_LENGTH=16
HASHER_PARALLELISM=1
HASHER_TIME_COST=1
HASHER_MEMORY_COST=4096

# -----------------------------------------------------------------------------
# IDENTIFICADORES — Manter os mesmos padrões da produção
#
# Manter nanoid e o mesmo alfabeto garante que os Type Guards (isAppID,
# isDatabaseID) se comportem identicamente nos testes e em produção.
# Alterar o padrão aqui criaria um ambiente de teste que não reflete a realidade.
# -----------------------------------------------------------------------------
IDENTIFIER_PATTERN=nanoid
IDENTIFIER_NANOID_ALPHABET=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_
IDENTIFIER_NANOID_SIZE=21
